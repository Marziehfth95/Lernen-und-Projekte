# Local application settings. Copy to .env and replace placeholders locally.
APP_ENV=local
LOG_LEVEL=INFO

# Optional Phase 4 real-model mode. DefaultAzureCredential is used; no key belongs here.
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
MODEL_DEPLOYMENT_NAME=replace-with-deployment-name
ALLOW_PAID_MODEL_CALLS=false
RUN_REAL_MODEL_EVALS=false
PROCESS_OPTIMIZER_ANALYSIS_DIR=data/processed/process_mining

# Phase 6 local workflow. Workflow endpoints remain inaccessible until identities are
# explicitly configured. Never reuse local bearer tokens outside development.
WORKFLOW_DATABASE_URL=sqlite:///data/local/workflow.sqlite3
LOCAL_AUTH_IDENTITIES_JSON={}

# Production Entra settings. Place real values in the deployment platform, never here.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=api://00000000-0000-0000-0000-000000000000
ENTRA_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
ENTRA_JWKS_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
ENTRA_ALLOWED_SERVICE_CLIENT_IDS=00000000-0000-0000-0000-000000000000
CONTAINER_APPS_AUTH_ENABLED=false

# Production PostgreSQL uses an Entra principal and short-lived managed-identity tokens.
WORKFLOW_DATABASE_AUTH_MODE=entra
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AGGREGATE_MANIFEST_PATH=/mnt/aggregates/aggregate_manifest.json
AGGREGATE_API_BASE_URL=https://replace-with-workflow-api.example
AGGREGATE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/.default
ENABLE_AZURE_MONITOR=false
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=placeholder;IngestionEndpoint=https://example.invalid
